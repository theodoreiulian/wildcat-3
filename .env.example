# Paper mode is default and never authenticates with Kraken.
# Live additionally requires an explicit --live flag.
WILDCAT_LIVE_ENABLED=false
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Optional Telegram push, sent only when you run the application.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fractional assumptions for paper only. Live fees come from Kraken TradeVolume.
WILDCAT_PAPER_MAKER_FEE=0.004
WILDCAT_PAPER_TAKER_FEE=0.008
